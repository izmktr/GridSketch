<Window x:Class="GridSketch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GridSketch"
        Title="GridSketch" Width="1240" Height="860" MinWidth="900" MinHeight="600" Background="#F2F5F8" FontFamily="Yu Gothic UI" Closing="WindowClosing">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規(_N)" InputGestureText="Ctrl+N" Click="NewClick"/>
        <MenuItem Header="開く(_O)…" InputGestureText="Ctrl+O" Click="OpenClick"/>
        <MenuItem x:Name="RecentFilesMenu" Header="最近使ったファイル(_R)"/>
        <Separator/>
        <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="SaveClick"/>
        <MenuItem Header="名前を付けて保存(_A)…" Click="SaveAsClick"/>
        <MenuItem Header="エクスポート(_E)">
          <MenuItem Header="PNG(_P)…" Click="ExportClick"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="ExitClick"/>
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Status" Text="マスをクリックして選択してください。"/></StatusBar>
    <Border DockPanel.Dock="Left" Width="300" Background="White" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="操作モード" FontSize="18" FontWeight="Bold"/>
          <ComboBox x:Name="EditMode" SelectedIndex="0" SelectionChanged="EditModeChanged">
            <ComboBoxItem Content="文字・画像を配置"/><ComboBoxItem Content="迷路の壁を編集"/>
          </ComboBox>
          <TextBlock Text="壁モードではマスの辺をクリックして、壁を追加・解除できます。" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Expander Header="迷路の壁の設定" Margin="0,0,0,12">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="壁の色（例：#162A40）"/><TextBox x:Name="WallColorBox"/>
              <TextBlock Text="壁の太さ（0より大きく12px以下）"/><TextBox x:Name="WallWidthBox"/>
              <Button Content="すべての壁に適用" Click="ApplyWallClick"/>
            </StackPanel>
          </Expander>
          <TextBlock Text="方眼紙" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
          <TextBlock Text="列数 / 行数（1～200）"/>
          <UniformGrid Columns="2"><TextBox x:Name="ColumnsBox" Margin="0,3,6,8"/><TextBox x:Name="RowsBox"/></UniformGrid>
          <TextBlock Text="1マスの大きさ（px）"/><TextBox x:Name="SizeBox"/>
          <TextBlock Text="画像の余白・上下左右共通（px）"/><TextBox x:Name="MarginBox"/>
          <Button Content="方眼紙設定を適用" Click="ApplyGridClick"/>
          <Separator Margin="0,14"/>
          <TextBlock Text="罫線" FontSize="18" FontWeight="Bold"/>
          <ComboBox x:Name="StrokeTarget" SelectionChanged="StrokeTargetChanged"><ComboBoxItem Content="外周の縦線"/><ComboBoxItem Content="外周の横線"/><ComboBoxItem Content="内側の縦線"/><ComboBoxItem Content="内側の横線"/></ComboBox>
          <TextBlock Text="色（例：#AAB8C5）"/><TextBox x:Name="ColorBox"/>
          <TextBlock Text="太さ（0～12px / 0で非表示）"/><TextBox x:Name="WidthBox"/>
          <ComboBox x:Name="KindBox"><ComboBoxItem Content="実線"/><ComboBoxItem Content="破線"/><ComboBoxItem Content="点線"/></ComboBox>
          <Button Content="選択した区分に適用" Click="ApplyStrokeClick"/>
          <Separator Margin="0,14"/>
          <TextBlock x:Name="CellTitle" Text="マスを選択" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="文字（1文字）"/><TextBox x:Name="TextBox"/>
          <TextBlock Text="フォント"/><ComboBox x:Name="FontBox" IsEditable="True"/>
          <TextBlock Text="文字サイズ（px）"/><TextBox x:Name="FontSizeBox" Text="28"/>
          <Button Content="文字を配置 / 更新" Click="TextClick"/>
          <Button Content="画像を配置 / 置換…" Click="ImageClick"/>
          <Button Content="このマスの内容を削除" Click="DeleteClick"/>
          <Separator Margin="0,14"/>
          <TextBlock Text="表示倍率"/><Slider x:Name="Zoom" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="ZoomChanged"/>
          <TextBlock Text="PNG出力倍率" Margin="0,12,0,0"/>
          <ComboBox x:Name="ExportScale" SelectedIndex="0"><ComboBoxItem Content="1倍"/><ComboBoxItem Content="2倍"/><ComboBoxItem Content="3倍"/><ComboBoxItem Content="4倍"/></ComboBox>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="28">
      <local:GridSurface x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="SurfaceClick" MouseMove="SurfaceMove" MouseLeave="SurfaceLeave"/>
    </ScrollViewer>
  </DockPanel>
</Window>
