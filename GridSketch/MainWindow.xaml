<Window x:Class="GridSketch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GridSketch"
 Title="GridSketch" Width="1380" Height="900" MinWidth="1000" MinHeight="650" Background="#F2F5F8" FontFamily="Yu Gothic UI" Closing="WindowClosing">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="ファイル(_F)">
    <MenuItem Header="新規(_N)…" InputGestureText="Ctrl+N" Click="NewClick"/>
    <MenuItem Header="開く(_O)…" InputGestureText="Ctrl+O" Click="OpenClick"/>
    <MenuItem x:Name="RecentFilesMenu" Header="最近使ったファイル(_R)"/>
    <Separator/>
    <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="SaveClick"/>
    <MenuItem Header="名前を付けて保存(_A)…" Click="SaveAsClick"/>
    <MenuItem Header="エクスポート(_E)"><MenuItem Header="PNG(_P)…" Click="ExportClick"/></MenuItem>
    <Separator/><MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="ExitClick"/>
   </MenuItem>
   <MenuItem Header="編集(_E)">
    <MenuItem Header="元に戻す(_U)" Command="ApplicationCommands.Undo"/>
    <MenuItem Header="やり直し(_R)" Command="ApplicationCommands.Redo"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Background="White" Padding="8">
   <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="追加" VerticalAlignment="Center" Margin="8,0"/>
    <ComboBox x:Name="AddKind" Width="155" SelectedIndex="0" Margin="0">
     <ComboBoxItem Content="グリッド（プリセット）"/><ComboBoxItem Content="グループ"/><ComboBoxItem Content="罫線"/><ComboBoxItem Content="グリッド文字"/><ComboBoxItem Content="セル塗り"/><ComboBoxItem Content="画像"/><ComboBoxItem Content="フリーテキスト"/><ComboBoxItem Content="ライン・矢印"/><ComboBoxItem Content="図形"/>
    </ComboBox><Button Content="追加する" Click="AddClick"/>
    <Separator Width="12"/>
    <ComboBox x:Name="ModeBox" Width="170" SelectedIndex="1" SelectionChanged="ModeChanged" Margin="8,0">
     <ComboBoxItem Content="選択・ドラッグ移動"/><ComboBoxItem Content="マス・辺を編集"/>
    </ComboBox>
    <TextBlock Text="表示" VerticalAlignment="Center"/><Slider x:Name="Zoom" Width="110" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="ZoomChanged" Margin="8,0"/>
    <Button Content="キャンバスへ" Click="CenterClick"/>
    <TextBlock Text="PNG倍率" VerticalAlignment="Center" Margin="12,0,4,0"/>
    <ComboBox x:Name="ExportScale" Width="60" SelectedIndex="0" Margin="0"><ComboBoxItem Content="1倍"/><ComboBoxItem Content="2倍"/><ComboBoxItem Content="3倍"/><ComboBoxItem Content="4倍"/></ComboBox>
   </WrapPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Status" Text="レイヤーを選択して編集します。"/></StatusBar>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="370" MinWidth="300"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#8191A3">
    <Grid>
     <local:SceneSurface x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="SurfaceDown" MouseMove="SurfaceMove" MouseLeftButtonUp="SurfaceUp" MouseLeave="SurfaceLeave" LostMouseCapture="SurfaceLostCapture"/>
     <Canvas x:Name="InputOverlay">
      <TextBox x:Name="GridInput" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="160" Height="32" PreviewMouseLeftButtonDown="SurfaceDown" TextChanged="GridInputChanged" PreviewKeyDown="GridInputKey" LostKeyboardFocus="GridInputLostFocus" AutomationProperties.Name="選択マスへの文字入力"/>
     </Canvas>
    </Grid>
   </ScrollViewer>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCD4DE"/>
   <Grid Grid.Column="2" Background="White">
    <Grid.RowDefinitions><RowDefinition Height="280" MinHeight="160"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="10">
     <TextBlock DockPanel.Dock="Top" Text="レイヤー" FontSize="18" FontWeight="Bold" Margin="4,0,0,8"/>
     <WrapPanel DockPanel.Dock="Bottom">
      <Button Content="↑" ToolTip="手前へ" Click="LayerUp"/><Button Content="↓" ToolTip="奥へ" Click="LayerDown"/>
      <Button Content="グループ化" Click="WrapClick"/><Button Content="解除" Click="UngroupClick"/><Button Content="削除" Click="DeleteClick"/>
     </WrapPanel>
     <TreeView x:Name="Layers" SelectedItemChanged="LayerSelected" BorderThickness="0"/>
    </DockPanel>
    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#CCD4DE"/>
    <DockPanel Grid.Row="2" Margin="14">
     <TextBlock DockPanel.Dock="Top" Text="プロパティ" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Properties"/></ScrollViewer>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
