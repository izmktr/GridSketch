<Window x:Class="GridSketch.PropertyHelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="マス切り替えのヘルプ" Width="400" Height="720" MinWidth="320" MinHeight="360" FontFamily="Yu Gothic UI" WindowStyle="ToolWindow" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
   <Border x:Name="PropertyHelpPanel" Background="#F7F9FC" BorderBrush="#D6DFE9" BorderThickness="1,0" Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <DockPanel>
       <TextBlock x:Name="HelpHeading" Text="マス切り替えのヘルプ" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="HelpSubtitle" Text="マスごとに、絵や図形を切り替える" Foreground="#52677D" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="マスをクリックすると、登録した画像・図形・グループが順番に切り替わります。" TextWrapping="Wrap" LineHeight="22"/>
       <Border Background="White" BorderBrush="#D6DFE9" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,18">
        <StackPanel>
         <TextBlock Text="例えば、じゃんけんパズル" FontWeight="SemiBold" Margin="0,0,0,10"/>
         <TextBlock Text="空 → グー → チョキ → パー" Foreground="#1457A6" FontSize="14" TextWrapping="Wrap"/>
         <TextBlock Text="最後の状態の次は、空に戻ります。" Foreground="#52677D" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <TextBlock Text="まずはこの3ステップ" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
       <TextBlock Text="1. マス切り替えの子に、画像や図形を追加します。&#10;2. 状態の選択欄で、表示する子を選びます。&#10;3.「マス・辺を編集」でマスをクリックします。" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"/>
       <Expander Header="状態リストの操作" IsExpanded="True" Margin="0,0,0,12">
        <TextBlock Text="≡ をドラッグして、青い線の位置へ並べ替えます。順番を変えても、配置済みのマスの絵は変わりません。&#10;&#10;ゴミ箱は状態を削除し、その状態のマスを空にします。見本の画像・図形自体は残ります。&#10;&#10;「＋ 状態を追加」で状態を増やせます。" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
       </Expander>
       <Expander Header="ドラッグでまとめて配置" Margin="0,0,0,12">
        <TextBlock Text="最初にクリックしたマスの変更後の状態を、ドラッグしたマスへ続けて配置します。&#10;&#10;Shift＋クリックで範囲を選び、「選択範囲を空にする」でまとめて消せます。" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
       </Expander>
       <TextBlock Text="見本の配置" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,10"/>
       <Expander Header="子のプロパティで配置を設定" IsExpanded="True" Margin="0,0,0,12">
        <TextBlock Text="マス切り替えの直下の見本に、マス全体（親の外側）と余白の内側を渡します。子のプロパティで配置先・サイズの扱い・位置合わせを指定します。&#10;&#10;グループは自身の幅・高さを基準に、子をまとめて拡縮します。例えば100×100のグループに60×60の画像を置けば、残りの空きも含めて配置できます。別の子のサイズを変えてもグループ全体の倍率は変わりません。整理用グループは親の範囲をそのまま子へ渡します。&#10;&#10;「固定」は自身のサイズを維持、「収める」は縦横比を維持して拡大・縮小、「広げる」は縦横それぞれを配置先に合わせます。マス全体の外にはみ出た部分は切り取られます。" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
       </Expander>
       <TextBlock Text="以前のファイルは、保存されている配置方式で表示します。" Foreground="#52677D" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>
       <TextBlock Text="変更は即時反映されます。Ctrl＋Zで元に戻せます。" Foreground="#52677D" TextWrapping="Wrap" LineHeight="22" Margin="0,4,0,12"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
</Window>
